INSTAGRAM_USERNAME=your_instagram_handle

# Cron schedule (default: every hour)
# Examples:
#   0 * * * *      — every hour
#   0 */12 * * *   — every 12 hours
#   0 9,21 * * *   — at 9:00 and 21:00
CRON_SCHEDULE="0 * * * *"

# Max parallel video analysis workers (whisper + ffmpeg run in parallel)
MAX_WORKERS=3

# LLM Provider Configuration
# Supports any OpenAI-compatible API (LM Studio, OpenRouter, Ollama, vLLM, etc.)
#
# LM Studio (local):
#   LLM_BASE_URL=http://host.docker.internal:1234/v1
#   LLM_API_KEY=not-needed (or set if auth enabled)
#
# OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...
#
# Ollama:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_API_KEY=not-needed

# Base URL for LLM API (OpenAI-compatible endpoint)
# For LM Studio: http://host.docker.internal:1234/v1
# For OpenRouter: https://openrouter.ai/api/v1
# For Ollama: http://host.docker.internal:11434/v1
LLM_BASE_URL=http://host.docker.internal:1234/v1

# Model name (must match the model identifier at your provider)
# LM Studio: qwen2.5-vl-7b-instruct (or whatever you loaded)
# OpenRouter: qwen/qwen2.5-vl-7b-instruct
LLM_MODEL=qwen2.5-vl-7b-instruct

# Optional: API key (only set if your provider requires authentication)
# LLM_API_KEY=your_token_here

# Max concurrent requests to LLM (default 1 — local models handle one at a time)
# Increase only if your hardware/provider can handle parallel requests
LLM_CONCURRENCY=1

# Set to true if your model supports native video input (e.g. Qwen2.5-VL, Qwen3.5)
# false = sample frames from video and send as images (default, works with any vision model)
# true  = send the full video file directly to the model
LLM_NATIVE_VIDEO=false

# Thinking budget for reasoning models (Qwen3, DeepSeek-R1, etc.)
# -1 = unlimited
#  0 = thinking disabled (fastest, less accurate)
# 512 = limit reasoning to 512 tokens (good balance for structured tasks like JSON)
LLM_THINKING_BUDGET=512

# Max tokens for visual description (frames or native video)
LLM_MAX_TOKENS_VISUAL=4096

# Max tokens for metadata generation (summary, category, tags)
# For reasoning models set higher to leave room after thinking
LLM_MAX_TOKENS_METADATA=8192
